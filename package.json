{
  "name": "praxia-registro",
  "version": "2026.10.19",
  "private": true,
  "description": "Praxia · Registro — revenue ledger for private medical practices (static front end + Supabase).",
  "scripts": {
    "serve": "serve -l 8888 .",
    "lint": "eslint .",
    "format": "prettier --write \"*.{js,css,json,md}\" \"docs/**/*.md\" \"tests/**/*.js\" \"scripts/**/*.js\"",
    "format:check": "prettier --check \"tests/**/*.js\" \"scripts/**/*.js\" \"config.js\"",
    "check:html": "node scripts/check-html.js",
    "test:sql": "bash scripts/test-sql.sh",
    "test:e2e": "node tests/e2e/run.js",
    "check": "npm run lint && npm run check:html && npm run test:sql && npm run test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@supabase/supabase-js": "2.117.2",
    "eslint": "^10.1.0",
    "globals": "^17.13.0",
    "playwright": "^1.56.1",
    "prettier": "^3.8.1",
    "serve": "^14.2.6"
  },
  "engines": {
    "node": ">=20"
  }
}
